# Copy to .env and replace placeholder values. Never commit the real .env.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.internal
ADMIN_PASSWORD=replace-with-a-long-random-password

# Keep false for local plain HTTP. Set true only when production HTTPS is enabled.
COOKIE_SECURE=false

# Optional; defaults to ./data/sentinel.db
DATABASE_PATH=./data/sentinel.db
