  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
